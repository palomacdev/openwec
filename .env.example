# OpenWEC — Environment Configuration
#
# Copy to .env and fill in real values. .env is gitignored and must never be
# committed.
#
# These names match api/config.py (pydantic-settings, case-insensitive) and the
# .env currently in use on the production VM. The example values below are the
# real production topology for everything that is NOT a secret; secrets are
# placeholders.

# --- Database ---------------------------------------------------------------
# Inside docker compose the API reaches the database by service name.
# Running the API outside compose, use 127.0.0.1 and the published port 5433.
DB_HOST=db
DB_PORT=5432
DB_NAME=openwec
DB_USER=openwec
DB_PASSWORD=change-me

# DB_PASSWORD is also consumed by docker-compose.prod.yml to set
# POSTGRES_PASSWORD on the database container. Both must be the same value or
# the API cannot authenticate.

# --- Redis ------------------------------------------------------------------
# Used for rate limiting. The API falls back to in-memory if Redis is absent.
REDIS_HOST=redis
REDIS_PORT=6379

# --- API keys ---------------------------------------------------------------
# Comma-separated list of static keys for the protected read endpoints.
# Leave empty in development.
# Note: docker compose treats $ as a variable prefix; escape a literal $ as $$.
#
# A key listed here is an ordinary API key. It may be handed to a consumer, and
# it does NOT authorize /admin/*.
API_KEYS=

# --- Admin credentials -------------------------------------------------------
# Comma-separated, and entirely separate from API_KEYS. Only these authorize
# /api/v1/admin/*, which lists every issued key in plaintext with the
# requester's name and e-mail, and can revoke any of them.
#
# Sent in its own header, X-Admin-Key.
#
# Fail-closed by design: leave it empty and the admin routes reject everything.
# A value shorter than 32 characters is treated as absent, and a value that
# also appears in API_KEYS is ignored — so copying a public key in here closes
# administration rather than opening it.
#
# Generate one per operator, on the host where it will be used:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEYS=

# --- Pagination (optional, defaults in api/config.py) -----------------------
# DEFAULT_PAGE_SIZE=50
# MAX_PAGE_SIZE=500

# --- Dashboard ---------------------------------------------------------------
# The dashboard is a Vite build and does NOT read this file. Its own build-time
# variables live in dashboard/.env.production -- the package root, which is
# where Vite loads env files from, NOT dashboard/src/. Gitignored.
#
#   VITE_API_BASE_URL   e.g. https://api.openwec.com/api/v1
#
# There is deliberately no key here. Vite inlines build-time variables, so
# anything put in that file is served as a string constant to every visitor.
# The endpoints the dashboard draws read without a credential.
#
# Write the file as UTF-8 without a BOM: a BOM lands inside the first
# variable's name, and a parser that does not strip it skips that line.
