# OpenWEC — Environment Configuration
#
# Copy to .env and fill in real values. .env is gitignored and must never be
# committed.
#
# These names match api/config.py (pydantic-settings, case-insensitive) and the
# .env currently in use on the production VM. The example values below are the
# real production topology for everything that is NOT a secret; secrets are
# placeholders.

# --- Database ---------------------------------------------------------------
# Inside docker compose the API reaches the database by service name.
# Running the API outside compose, use 127.0.0.1 and the published port 5433.
DB_HOST=db
DB_PORT=5432
DB_NAME=openwec
DB_USER=openwec
DB_PASSWORD=change-me

# DB_PASSWORD is also consumed by docker-compose.prod.yml to set
# POSTGRES_PASSWORD on the database container. Both must be the same value or
# the API cannot authenticate.

# --- Redis ------------------------------------------------------------------
# Used for rate limiting. The API falls back to in-memory if Redis is absent.
REDIS_HOST=redis
REDIS_PORT=6379

# --- API keys ---------------------------------------------------------------
# Comma-separated list of static keys. Leave empty in development.
# Note: docker compose treats $ as a variable prefix; escape a literal $ as $$.
API_KEYS=

# --- Trusted proxies ---------------------------------------------------------
# Comma-separated addresses or CIDR blocks whose X-Forwarded-For may be
# believed. Used only to decide which address the rate limiter meters.
#
# EMPTY IS SAFE AND WRONG IN PRODUCTION. With no entry the header is ignored,
# so nothing can be forged -- but behind nginx every caller then arrives with
# the proxy's address and they all share one 60/min bucket. The API logs
# `trusted_proxies_unset` at start-up while that is the case.
#
# Set it to the address the API sees nginx connect FROM, which is not
# necessarily the address nginx proxies TO. On the host, with the API running:
#
#   docker logs openwec-api 2>&1 | grep client_ip | tail -5
#
# With `ports: "127.0.0.1:8000:8000"` that is usually the bridge gateway of
# the compose network, e.g.:
#
#   docker network inspect openwec_default -f '{{(index .IPAM.Config 0).Gateway}}'
#
# Then, for example:  TRUSTED_PROXIES=172.18.0.1
# A whole bridge range also works: TRUSTED_PROXIES=172.16.0.0/12
#
# Do not list an address a client could connect from directly. The API port is
# published on loopback only, so the reachable set is the host itself and the
# containers on its bridge networks.
TRUSTED_PROXIES=

# --- Pagination (optional, defaults in api/config.py) -----------------------
# DEFAULT_PAGE_SIZE=50
# MAX_PAGE_SIZE=500

# --- Dashboard ---------------------------------------------------------------
# The dashboard is a Vite build and does NOT read this file. Its own build-time
# variables live in dashboard/src/.env.production (gitignored):
#   VITE_API_BASE_URL   e.g. https://api.openwec.com
#   VITE_API_KEY        a key from API_KEYS above
