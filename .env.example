# OpenWEC — Environment Configuration
#
# Copy to .env and fill in real values. .env is gitignored and must never be
# committed.
#
# These names match api/config.py (pydantic-settings, case-insensitive) and the
# .env currently in use on the production VM. The example values below are the
# real production topology for everything that is NOT a secret; secrets are
# placeholders.

# --- Database ---------------------------------------------------------------
# Inside docker compose the API reaches the database by service name.
# Running the API outside compose, use 127.0.0.1 and the published port 5433.
DB_HOST=db
DB_PORT=5432
DB_NAME=openwec
DB_USER=openwec
DB_PASSWORD=change-me

# DB_PASSWORD is also consumed by docker-compose.prod.yml to set
# POSTGRES_PASSWORD on the database container. Both must be the same value or
# the API cannot authenticate.

# --- Redis ------------------------------------------------------------------
# Used for rate limiting. The API falls back to in-memory if Redis is absent.
REDIS_HOST=redis
REDIS_PORT=6379

# --- API keys ---------------------------------------------------------------
# Comma-separated list of static keys. Leave empty in development.
# Note: docker compose treats $ as a variable prefix; escape a literal $ as $$.
API_KEYS=

# --- Pagination (optional, defaults in api/config.py) -----------------------
# DEFAULT_PAGE_SIZE=50
# MAX_PAGE_SIZE=500

# --- Dashboard ---------------------------------------------------------------
# The dashboard is a Vite build and does NOT read this file. Its own build-time
# variables live in dashboard/src/.env.production (gitignored):
#   VITE_API_BASE_URL   e.g. https://api.openwec.com
#   VITE_API_KEY        a key from API_KEYS above
